# spec.md의 API를 손으로 확인하는 요청 모음 (VS Code 확장 REST Client 필요)
# 1. 터미널에서 `npm start`로 서버를 켭니다.
# 2. 위에서부터 차례대로 각 ### 위의 Send Request를 누릅니다.
#    (# @name이 붙은 요청의 응답에서 글 번호를 꺼내 쓰므로, 1번을 먼저 보내야 합니다)

@baseUrl = http://localhost:3000
@entryId = {{create.response.body.$.id}}
@limitId = {{limitTarget.response.body.$.id}}

######## 4.1. 글 작성 ########

### 1. 글 작성 → 201, 응답에 password/passwordHash 없음
# @name create
POST {{baseUrl}}/entries
Content-Type: application/json

{ "name": "이승우", "content": "방명록 남기고 갑니다!", "password": "0123" }

### 2. 이름이 공백뿐 → 400
POST {{baseUrl}}/entries
Content-Type: application/json

{ "name": "   ", "content": "안녕하세요", "password": "1234" }

### 3. 이름이 21자 → 400
POST {{baseUrl}}/entries
Content-Type: application/json

{ "name": "가나다라마바사아자차카타파하가나다라마바사", "content": "안녕하세요", "password": "1234" }

### 4. 비밀번호가 세 자리 → 400
POST {{baseUrl}}/entries
Content-Type: application/json

{ "name": "이승우", "content": "안녕하세요", "password": "123" }

### 5. 비밀번호가 숫자 타입(문자열 아님) → 400
POST {{baseUrl}}/entries
Content-Type: application/json

{ "name": "이승우", "content": "안녕하세요", "password": 1234 }

### 6. 필수 데이터(content) 없음 → 400
POST {{baseUrl}}/entries
Content-Type: application/json

{ "name": "이승우", "password": "1234" }

######## 4.2. 글 목록 조회 ########

### 7. 목록 (sort 생략 = 최신순) → 200
GET {{baseUrl}}/entries

### 8. 최신순 → 200
GET {{baseUrl}}/entries?sort=newest

### 9. 오래된순 → 200
GET {{baseUrl}}/entries?sort=oldest

### 10. 잘못된 sort → 400
GET {{baseUrl}}/entries?sort=popular

######## 4.3. 글 수정 ########

### 11. 이름만 수정 → 200, 내용은 그대로, updatedAt 갱신
PATCH {{baseUrl}}/entries/{{entryId}}
Content-Type: application/json

{ "name": "승우", "password": "0123" }

### 12. 이름과 내용 둘 다 없음 → 400
PATCH {{baseUrl}}/entries/{{entryId}}
Content-Type: application/json

{ "password": "0123" }

### 13. 글 번호 형식이 잘못됨 → 400
PATCH {{baseUrl}}/entries/abc
Content-Type: application/json

{ "content": "수정", "password": "0123" }

### 14. 비밀번호 불일치 → 403
PATCH {{baseUrl}}/entries/{{entryId}}
Content-Type: application/json

{ "content": "수정", "password": "9999" }

### 15. 없는 글 → 404
PATCH {{baseUrl}}/entries/99999
Content-Type: application/json

{ "content": "수정", "password": "0123" }

######## 4.4. 글 삭제 ########

### 16. 비밀번호 불일치 → 403
DELETE {{baseUrl}}/entries/{{entryId}}
Content-Type: application/json

{ "password": "9999" }

### 17. 비밀번호 없음 → 400
DELETE {{baseUrl}}/entries/{{entryId}}
Content-Type: application/json

{}

### 18. 삭제 → 204
DELETE {{baseUrl}}/entries/{{entryId}}
Content-Type: application/json

{ "password": "0123" }

### 19. 삭제한 글 다시 삭제 → 404
DELETE {{baseUrl}}/entries/{{entryId}}
Content-Type: application/json

{ "password": "0123" }

######## 6. 비밀번호 확인 요청 횟수 제한 ########

### 20. 횟수 제한을 확인할 글 작성 → 201
# @name limitTarget
POST {{baseUrl}}/entries
Content-Type: application/json

{ "name": "제한테스트", "content": "횟수 제한 확인용 글", "password": "5555" }

### 21. 틀린 비밀번호로 1분 안에 6번 보내기 → 1~5번째 403, 6번째 429 (Retry-After 헤더 확인)
DELETE {{baseUrl}}/entries/{{limitId}}
Content-Type: application/json

{ "password": "0000" }

### 22. 제한 중에는 맞는 비밀번호로도 429 (1분 지나면 204로 삭제됨)
DELETE {{baseUrl}}/entries/{{limitId}}
Content-Type: application/json

{ "password": "5555" }
